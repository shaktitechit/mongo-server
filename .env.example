# =============================================================================
# MongoDB Server — Environment Variables
# Copy this file to .env and replace every CHANGE_ME value with a strong secret.
#
#   cp .env.example .env
#
# Generate strong passwords (examples):
#   openssl rand -hex 32
#   openssl rand -base64 32
# Prefer hex for simpler shell/Compose quoting; both are fine.
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB Docker image (pin a minor series for reproducible deploys)
# Official Community image: https://hub.docker.com/_/mongo
# -----------------------------------------------------------------------------
MONGO_IMAGE=mongo:8.2

# -----------------------------------------------------------------------------
# Container / host networking
# Use 127.0.0.1 in production so MongoDB is NOT exposed to the public internet.
# Use 0.0.0.0 only for local development if you need LAN access (not recommended).
# -----------------------------------------------------------------------------
MONGO_HOST_BIND=127.0.0.1
MONGO_PORT=27017

# -----------------------------------------------------------------------------
# Root administrator (administration / backups / user management ONLY)
# Applications MUST NOT use this account.
# -----------------------------------------------------------------------------
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_root_Use_openssl_rand_base64_32

# Database name used during first-boot init (admin is fine; init.js creates app DBs)
MONGO_INITDB_DATABASE=admin

# -----------------------------------------------------------------------------
# Application database users
# Each app gets readWrite on its own database only.
# -----------------------------------------------------------------------------

# OPMS
OPMS_DB_NAME=opms
OPMS_DB_USER=opms_user
OPMS_DB_PASSWORD=CHANGE_ME_opms_Use_openssl_rand_base64_32

# CRM
CRM_DB_NAME=crm
CRM_DB_USER=crm_user
CRM_DB_PASSWORD=CHANGE_ME_crm_Use_openssl_rand_base64_32

# Website
WEBSITE_DB_NAME=website
WEBSITE_DB_USER=website_user
WEBSITE_DB_PASSWORD=CHANGE_ME_website_Use_openssl_rand_base64_32

# Inventory
INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=CHANGE_ME_inventory_Use_openssl_rand_base64_32

# Analytics
ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=CHANGE_ME_analytics_Use_openssl_rand_base64_32

# Power App
POWERAPP_DB_NAME=powerapp
POWERAPP_DB_USER=powerapp_user
POWERAPP_DB_PASSWORD=CHANGE_ME_powerapp_Use_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# Backup settings
# Daily backups run automatically via the mongo-backup Compose service.
# -----------------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30
# Hour/minute in UTC (default: 02:00 UTC every day)
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=0
# Set true to also backup once when mongo-backup starts
BACKUP_RUN_ON_STARTUP=false
