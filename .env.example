# =============================================================================
# MongoDB Server — Environment Variables Example
#
# Copy this file to .env and replace MONGO_ROOT_PASSWORD with a strong secret.
#
#   cp .env.example .env
# =============================================================================

# Container Image & Ports
MONGO_IMAGE=mongo:8.2
MONGO_HOST_BIND=127.0.0.1
MONGO_PORT=27017

# Root Administrator (Ops Console / Backups / Maintenance ONLY)
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_root_Use_openssl_rand_base64_32
MONGO_INITDB_DATABASE=admin

# High Availability & Resource Limits
REPLICA_SET_NAME=rs0
MONGO_CPU_LIMIT=2.0
MONGO_MEMORY_LIMIT=2G
MONGO_CPU_RESERVE=0.5
MONGO_MEMORY_RESERVE=512M

# Backup & Disaster Recovery
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_HOUR=2
BACKUP_SCHEDULE_MINUTE=0
BACKUP_RUN_ON_STARTUP=false

# Ops Console Dashboard & Monitoring
DASHBOARD_HOST_BIND=127.0.0.1
DASHBOARD_PORT=8002
EXPORTER_HOST_BIND=127.0.0.1
EXPORTER_PORT=9216
